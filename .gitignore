# Dependencies
node_modules/
__pycache__/
*.pyc
venv/

# Build output
dist/

# Environment / secrets
.env
# MCP project-scope config — embeds the admin bearer token in env, so it's
# per-developer rather than shared.
.mcp.json

# Database (user data, recreated on first run)
*.db
*.db.bak.*
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local design references (mockups, screenshots) — not source
Feed_mock_ups/

# Local working dir — ad-hoc exports, scratch JSON, dev-only artifacts.
# Anything in here is for the developer's local use; not source-of-truth.
local/

# Uploads (user-generated profile photos)
Community/coffee-community-api/uploads/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude session artifacts
.claude/

# Log files
*.log

# Local scratch / dev artifacts — never source
tmp/

# Catalog-ops orchestrator workspace — track only the operating docs +
# run history; everything else (architecture drafts, audit dumps, .claude
# session artifacts) stays local.
agent-catalog-ops/*
!agent-catalog-ops/CLAUDE.md
!agent-catalog-ops/RUNBOOK.md
!agent-catalog-ops/run_history/
