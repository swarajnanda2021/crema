# Crema API — environment variables reference.
#
# Copy to `.env` (gitignored) and fill in your real values. The actual
# `.env` file is never committed; this `.env.example` is the canonical
# documentation of which variables the backend reads.
#
# Read-path is the same in dev (loaded from .env via python-dotenv in
# main.py) and prod (injected by Fly via `fly secrets set …`).

# Required for any Sonnet-driven feature (admin Catalog Ops bio
# enrichment, per-product enrichment, SCA tag classification). If
# missing, those features degrade gracefully — products land with
# enrichment_status='deferred' and the admin can re-enrich later.
ANTHROPIC_API_KEY=sk-ant-...

# SQLite path. Local dev: leave unset to use ./coffee_community.db.
# Production (Fly volume): /data/coffee_community.db
DB_PATH=./coffee_community.db

# Where multipart uploads land. Local dev: ./uploads
# Production (Fly volume): /data/uploads
UPLOADS_DIR=./uploads

# CORS allowlist for the FastAPI app. Local dev: * (any origin).
# Production: comma-separated list, e.g. https://cremabrews.com
CORS_ORIGINS=*
